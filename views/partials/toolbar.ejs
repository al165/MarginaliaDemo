<div id="room-toolbar">
  <div id="tool-glow"></div>

  <!-- <img src="<%= room.baseURL %>/icons/02_pencil.svg" alt="pencil" class="tool coming-soon" id="pencil"> -->
  <img src="<%= room.baseURL %>/icons/03_themes.svg" alt="themes" class="tool" id="themes">
  <img src="<%= room.baseURL %>/icons/04_viewmode.svg" alt="viewmode" class="tool coming-soon" id="viewmode">
