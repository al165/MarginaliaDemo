<form action="<%= room.baseURL %>/upload" id="image-upload-form" method="post" enctype="multipart/form-data">
  <input type="file" name="file" id="imgupload" style="display:none" accept="image/*" />
</form>

<div id="text-toolbar">
  <img src="<%= room.baseURL %>/icons/24_bold.svg" alt="bold" class="tool" id="bold">
  <img src="<%= room.baseURL %>/icons/23_italic.svg" alt="italic" class="tool" id="italic">
  <img src="<%= room.baseURL %>/icons/22_underline.svg" alt="underline" class="tool" id="underline">
  <img src="<%= room.baseURL %>/icons/21_strikethrough.svg" alt="strikethrough" class="tool" id="strikethrough">
  <img src="<%= room.baseURL %>/icons/20_heading.svg" alt="heading" class="tool" id="heading">
  <img src="<%= room.baseURL %>/icons/19_writingdirection_leftright.svg" alt="writingdirection" class="tool" id="writingdirection">
  <img src="<%= room.baseURL %>/icons/18_justification_left.svg" alt="justification" class="tool" id="justification">
  <img src="<%= room.baseURL %>/icons/17_bulletnumbers.svg" alt="bullet numbers" class="tool" id="bulletnumbers">
  <img src="<%= room.baseURL %>/icons/16_bulletpoints.svg" alt="bullet points" class="tool" id="bulletpoints">
  <img src="<%= room.baseURL %>/icons/15_citation.svg" alt="quote" class="tool" id="citation">
  <img src="<%= room.baseURL %>/icons/14_font.svg" alt="font" class="tool" id="font">
  <div id="insert-toolbar">
    <img src="<%= room.baseURL %>/icons/13_audio.svg" alt="audio" class="tool coming-soon" id="audio">
    <img src="<%= room.baseURL %>/icons/12_video.svg" alt="video" class="tool" id="video">
    <img src="<%= room.baseURL %>/icons/11_image.svg" alt="image" class="tool" id="image-add">
    <img src="<%= room.baseURL %>/icons/10_links.svg" alt="link" class="tool" id="links">
  </div>
</div>

<div id="tooltip" class="drop-shadow"></div>

<div id="highlight-toolbar">
  <img src="<%= room.baseURL %>/icons/01_highlight.svg" alt="highlight" class="tool" id="highlight">
  <div id="highlight-colour" class="colour-choice"></div>
  <div id="highlight-colour-pallette"></div>
</div>

<dialog id="link-editor">
  <div>
    <input type="text" placeholder="Full URL, including http://" name="url" id="link-editor-url">
    <button id="link-editor-add-btn">Add link</button>
    <form method="dialog">
      <button>Cancel</button>
    </form>
  </div>
</dialog>

<dialog id="video-editor" class="centered">
  <div>
    Paste a link to YouTube or Vimeo below to embed into the note:
    <input type="text" placeholder="Video URL" name="url" id="video-editor-url">
    <button type="button" id="video-editor-add-btn">Add video</button>
    <form method="dialog">
      <button>Cancel</button>
    </form>
  </div>
</dialog>

<dialog id="image-editor" class="centered">
  <div>
    You can upload an image (which will be compressed and dithered)
    <button id="image-upload">Upload image</button>
    <br><em>or</em><br>
    paste a direct link to an image hosted somewhere else:
    <input type="text" placeholder="Image URL" name="image-url" id="image-editor-url">
    <button id="image-editor-submit">Submit</button>
    <br><br>
    <form method="dialog">
      <button>Cancel</button>
    </form>
  </div>
</dialog>

<dialog id="export-popup" class="centered">
  <div>
    <div class="buttons">
      <img src="<%= room.baseURL %>/icons/close.svg" class="btn" alt="close button" id="export-close-btn">
    </div>
    <h2>Share/Export this room</h2>
    <p>Share read-only version: <br><a id="read-only-link" target="_blank" rel="noopener noreferrer"></a> </p>
    <p>Share with editing access: <br><a id="with-edit-link" target="_blank" rel="noopener noreferrer"></a> </p>
    <p>Export as a single, static HTML file <br>(right-click and 'Save Link as'): <br><a id="static-link" target="_blank" rel="noopener noreferrer"></a> </p>

    <script defer>
      const readOnlyURL = location.origin + location.pathname;
      const withEditURL = location.href;
      const staticURL = location.origin + location.pathname.replace('/room/', '/static/');

      const readOnlyLink = document.getElementById('read-only-link');
      const withEditLink = document.getElementById('with-edit-link');
      const staticLink = document.getElementById('static-link');

      readOnlyLink.setAttribute('href', readOnlyURL);
      readOnlyLink.innerText = readOnlyURL;

      withEditLink.setAttribute('href', withEditURL);
      withEditLink.innerText = withEditURL;

      staticLink.setAttribute('href', staticURL);
      staticLink.innerText = staticURL;
    </script>
  </div>

</dialog>

<script src="<%= room.baseURL %>/js/editButtons.js" defer type="module"></script>