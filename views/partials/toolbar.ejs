    <img src="<%= room.baseURL %>/icons/13_audio.svg" alt="audio" class="tool coming-soon" id="audio">
    <img src="<%= room.baseURL %>/icons/12_video.svg" alt="video" class="tool" id="video">
    <img src="<%= room.baseURL %>/icons/11_image.svg" alt="image" class="tool" id="image-add">
    <img src="<%= room.baseURL %>/icons/10_links.svg" alt="link" class="tool" id="links">
  </div>
</div>

<div id="tooltip" class="drop-shadow"></div>

<script src="<%= room.baseURL %>/js/editButtons.js" defer type="module"></script>