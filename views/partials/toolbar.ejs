<div id="room-toolbar">
  <div id="tool-glow"></div>

  <button class="tool" id="themes"><img src="<%= room.baseURL %>/icons/03_themes.svg" alt="themes"></button>
  <button class="tool coming-soon" id="viewmode" disabled><img src="<%= room.baseURL %>/icons/04_viewmode.svg" alt="viewmode"></button>
  <button class="tool coming-soon" id="page" disabled><img src="<%= room.baseURL %>/icons/08_page.svg" alt="page"></button>
  <button class="tool" id="publish"><img src="<%= room.baseURL %>/icons/09_publish.svg" alt="publish"></button>
</div>

<form action="<%= room.baseURL %>/upload" id="image-upload-form" method="post" enctype="multipart/form-data">
  <input type="file" name="file" id="imgupload" style="display:none" accept="image/*" />
</form>

<div id="text-toolbar-scroll">
  <div id="text-toolbar">
    <button class="tool" id="bold"><img src="<%= room.baseURL %>/icons/24_bold.svg" alt="bold"></button>
    <button class="tool" id="italic"><img src="<%= room.baseURL %>/icons/23_italic.svg" alt="italic"></button>
    <button class="tool" id="underline"><img src="<%= room.baseURL %>/icons/22_underline.svg" alt="underline"></button>
    <button class="tool" id="strikethrough"><img src="<%= room.baseURL %>/icons/21_strikethrough.svg" alt="strikethrough"></button>
    <button class="tool" id="heading"><img src="<%= room.baseURL %>/icons/20_heading.svg" alt="heading"></button>
    <button class="tool" id="writingdirection"><img src="<%= room.baseURL %>/icons/19_writingdirection_leftright.svg" alt="writingdirection"></button>
    <button class="tool" id="justification"><img src="<%= room.baseURL %>/icons/18_justification_left.svg" alt="justification"></button>
    <button class="tool" id="bulletnumbers"><img src="<%= room.baseURL %>/icons/17_bulletnumbers.svg" alt="bullet numbers"></button>
    <button class="tool" id="bulletpoints"><img src="<%= room.baseURL %>/icons/16_bulletpoints.svg" alt="bullet points"></button>
    <button class="tool" id="citation"><img src="<%= room.baseURL %>/icons/15_citation.svg" alt="quote"></button>
    <button class="tool" id="font"><img src="<%= room.baseURL %>/icons/14_font.svg" alt="font"></button>
    <div id="insert-toolbar">
      <button class="tool coming-soon" id="audio" disabled><img src="<%= room.baseURL %>/icons/13_audio.svg" alt="audio"></button>
      <button class="tool" id="video"><img src="<%= room.baseURL %>/icons/12_video.svg" alt="video"></button>
      <button class="tool" id="image-add"><img src="<%= room.baseURL %>/icons/11_image.svg" alt="image"></button>
      <button class="tool" id="links"><img src="<%= room.baseURL %>/icons/10_links.svg" alt="link"></button>
    </div>
  </div>
</div>

<div id="tooltip" class="drop-shadow"></div>

<script src="<%= room.baseURL %>/dist/editButtons.js" defer type="module"></script>