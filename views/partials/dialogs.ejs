<div id="highlight-toolbar">
  <img src="<%= room.baseURL %>/icons/01_highlight.svg" alt="highlight" class="tool" id="highlight">
  <div id="highlight-colour" class="colour-choice"></div>
  <div id="highlight-colour-pallette"></div>
</div>

<div id="url-toolbar">
  <em>Follow link: </em><a target="_blank" rel="noopener noreferrer"></a> <img title="Remove link" src="<%= room.baseURL %>/icons/05_trash.svg" id="remove-link-btn">
</div>

<dialog id="link-editor">
  <div>
    <input type="text" placeholder="Full URL, including http://" name="url" id="link-editor-url">
    <button id="link-editor-add-btn">Add link</button>
  </div>
  <form method="dialog">
    <button class="dialog-close"><img src="<%= room.baseURL %>/icons/close.svg" alt=""></button>
  </form>
</dialog>

<dialog id="video-editor" class="centered">
  <div>
    Paste a link to YouTube or Vimeo below to embed into the note:
    <input type="text" placeholder="Video URL" name="url" id="video-editor-url">
    <button type="button" id="video-editor-add-btn">Add video</button>
  </div>
  <form method="dialog">
    <button class="dialog-close"><img src="<%= room.baseURL %>/icons/close.svg" alt=""></button>
  </form>
</dialog>

<dialog id="image-editor" class="centered">
  <div>
    You can upload an image (which will be compressed and dithered)
    <button id="image-upload">Upload image</button>
    <span id="image-upload-msg"></span>
    <hr />
    or paste a direct link to an image hosted somewhere else:
    <input type="text" placeholder="Image URL" name="image-url" id="image-editor-url">
    <button id="image-editor-submit">Submit</button>
  </div>
  <form method="dialog">
    <button class="dialog-close"><img src="<%= room.baseURL %>/icons/close.svg" alt=""></button>
  </form>
</dialog>

<dialog id="export-popup" class="centered">
  <div>
    <h2>Share/Export this room</h2>
    <p>Share read-only version: <br><a id="read-only-link" target="_blank" rel="noopener noreferrer"></a> </p>
    <p>Share with editing access: <br><a id="with-edit-link" target="_blank" rel="noopener noreferrer"></a> </p>
    <p>Export as a single, static HTML file <br>(right-click and 'Save Link as'): <br><a id="static-link" target="_blank" rel="noopener noreferrer"></a> </p>

    <script defer>
      const readOnlyURL = location.origin + location.pathname;
      const withEditURL = location.href;
      const staticURL = location.origin + location.pathname.replace('/room/', '/static/');

      const readOnlyLink = document.getElementById('read-only-link');
      const withEditLink = document.getElementById('with-edit-link');
      const staticLink = document.getElementById('static-link');

      readOnlyLink.setAttribute('href', readOnlyURL);
      readOnlyLink.innerText = readOnlyURL;

      withEditLink.setAttribute('href', withEditURL);
      withEditLink.innerText = withEditURL;

      staticLink.setAttribute('href', staticURL);
      staticLink.innerText = staticURL;
    </script>
    <form method="dialog">
      <button class="dialog-close"><img src="<%= room.baseURL %>/icons/close.svg" alt=""></button>
    </form>
  </div>

</dialog>

<dialog id="delete-popup" class="centered">
  <div>
    You are about to delete a note. This cannot be undone! Are you sure?
    <form method="dialog">
      <button>Cancel</button>
    </form>
    <button id="confirm-delete-btn">Yes, delete note</button>
  </div>
</dialog>

<script src="<%= room.baseURL %>/dist/dialogs.js" defer type="module"></script>