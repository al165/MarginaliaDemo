<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= room.name %>
  </title>

  <% if(room.renderStatic) { %>
  <%- favicon %>
  <% } else { %>
  <link rel="icon" type="ico" href="<%= room.baseURL %>/favicon.ico">
  <script src="<%= room.baseURL %>/dist/common.js"></script>
  <script src="<%= room.baseURL %>/dist/room.js"></script>
  <% } %>

  <script>
    const roomId = '<%= room.roomId %>';
    const roomName = '<%= room.name %>'
    const rootNote = '<%= room.rootNote %>';
    const theme = '<%= room.theme || "light" %>';
    const createdOn = '<%= room.createdOn %>';
    const params = new URLSearchParams(window.location.search);
    const editToken = params.get("editToken");
    const canEdit = '<%= room.canEdit %>' === 'true';
    const baseURL = '<%= room.baseURL %>';
    let editMode = false;

    console.log("theme: " + theme);
  </script>
  <% if(room.renderStatic) { %>
  <!-- Statically rendered data 
    - you may edit the data of the notes here, or add custom CSS properties, or any modifications you like!
  -->
  <style>
    <%- css %>
  </style>
  <% } else {%>
  <link rel="stylesheet" href="<%= room.baseURL %>/style.css">
  <% if(room.canEdit) {%>
  <link rel="stylesheet" href="<%= room.baseURL %>/styleEdit.css">
  <% } %>
  <% } %>
</head>

<body>
  <% if(room.renderStatic) { %>
  <!-- Feel free to use your own logo here, or remove it entirely -->
  <div class="logo" id="logo1"></div>
  <div class="logo" id="logo2"></div>
  <img src="<%= icons.logo %>" alt="marginalia logo" class="logo-text">
  <% } else { %>
  <a href="<%= room.baseURL %>/">
    <div class="logo" id="logo1"></div>
  </a>
  <a href="<%= room.baseURL %>/">
    <div class="logo" id="logo2"></div>
  </a>
  <img src="<%= room.baseURL %>/logo.svg" class="logo-text" alt="marginalia logo">
  <% } %>

  <% if(room.canEdit) { %>
  <%- include('partials/dialogs.ejs') %>
  <%- include('partials/toolbar.ejs') %>
  <% } %>

  <% if(room.renderStatic) { %>
  <!-- Here are the HTML contents of each annotation. Feel free to edit them! -->
  <!-- Custom notes should have the following structure: -->
  <!--   <div class="static-note" data-id="<some unique id string>" data-width="<width in pixels>" -->
  <!--     <p>Your note HTML here!</p> -->
  <!--     <p>Links to other <mark data-id="<target note id string>" data-color="<CSS color of highlight>">notes</mark> look like this</p> -->
  <!--   </div> -->
  <% for(const [noteId, noteData] of Object.entries(notes)) { %>
  <%- noteData.noteHtml %>
  <% } %>
  <!-- End of note data -->
  <% } %>

  <div id="notes"></div>

  <div id="note-buttons" class="buttons">

    <% if(room.renderStatic) { %>
    <img src="<%= icons.close %>" title="Close" draggable="false" class="btn" alt="close button" id="close-note">
    <img src="<%= icons.drag %>" title="Move" draggable="false" class="drag" alt="move note" id="drag-note">
    <img src="<%= icons.unbreak %>" title="Restore" draggable="false" class="btn" alt="restore button" id="restore-note">
    <% } else { %>
    <img src="<%= room.baseURL %>/icons/close.svg" title="Close" draggable="false" class="btn" alt="close button" id="close-note">
    <img src="<%= room.baseURL %>/icons/28_drag.svg" title="Move" draggable="false" class="drag" alt="move note" id="drag-note">
    <img src="<%= room.baseURL %>/icons/29_unbreak.svg" title="Restore" draggable="false" class="btn" alt="restore button" id="restore-note">
    <% } %>

    <% if(room.canEdit) { %>
    <img src="<%= room.baseURL %>/icons/26_resize.svg" title="Resize" draggable="false" class="handle" alt="resize note" id="resize-note">
    <img src="<%= room.baseURL %>/icons/05_trash.svg" title="Delete" draggable="false" class="btn" alt="remove note" id="remove-note">
    <% } // if(room.canEdit) %>

  </div>

  <% if(room.renderStatic) { %>
  <script type="module">
    <%- include('partials/generated/roomStatic.ejs') %>
  </script>
  <% } %>

</body>

</html>