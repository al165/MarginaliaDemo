<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= room.name %>
  </title>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.core.css" rel="stylesheet" />
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
  <link rel="stylesheet" href="<%= room.baseURL %>/style.css">
  <script>
    const roomId = '<%= room.roomId %>';
    const roomName = '<%= room.name %>'
    const rootNote = '<%= room.rootNote %>';
    const theme = '<%= room.theme || "light" %>';
    const createdOn = '<%= room.createdOn %>';
    const params = new URLSearchParams(window.location.search);
    const editToken = params.get("editToken");
    const canEdit = '<%= room.canEdit %>' === 'true';
    const baseURL = '<%= room.baseURL %>';
    let editMode = false;

    console.log("theme: " + theme);
  </script>
</head>

<body>
  <div class="logo" id="logo1"></div>
  <div class="logo" id="logo2"></div>
  <a href="<%= room.baseURL %>/"><img src="<%= room.baseURL %>/logo1.svg" alt="logo" class="logo-text"></a>
  <a href="<%= room.baseURL %>/"><img src="<%= room.baseURL %>/logo2.svg" alt="logo" class="logo-text"></a>

  <% if(room.canEdit) { %>
  <div id="room-toolbar">
    <img src="<%= room.baseURL %>/icons/01_highlight.svg" alt="highlight" class="tool" id="new-note">
    <img src="<%= room.baseURL %>/icons/02_pencil.svg" alt="pencil" class="tool coming-soon" id="pencil">
    <img src="<%= room.baseURL %>/icons/03_themes.svg" alt="themes" class="tool" id="themes">
    <img src="<%= room.baseURL %>/icons/04_viewmode.svg" alt="viewmode" class="tool coming-soon" id="viewmode">
    <img src="<%= room.baseURL %>/icons/05_trash.svg" alt="delete" class="tool coming-soon" id="trash">
    <img src="<%= room.baseURL %>/icons/06_undo.svg" alt="undo" class="tool coming-soon" id="undo">
    <img src="<%= room.baseURL %>/icons/07_info.svg" alt="info" class="tool coming-soon" id="info">
    <img src="<%= room.baseURL %>/icons/08_page.svg" alt="page" class="tool coming-soon" id="page">
    <a href="<%= room.baseURL %>/room/<%= room.roomId %>" target="_blank" rel="noopener noreferrer"><img src="<%= room.baseURL %>/icons/09_publish.svg" alt="publish" class="tool" id="publish"></a>
  </div>

  <form action="<%= room.baseURL %>/upload" id="image-upload-form" method="post" enctype="multipart/form-data">
    <input type="file" name="file" id="imgupload" style="display:none" accept="image/*" />
  </form>

  <div id="text-toolbar">
    <img src="<%= room.baseURL %>/icons/24_bold.svg" alt="bold" class="tool" id="bold">
    <img src="<%= room.baseURL %>/icons/23_italic.svg" alt="italic" class="tool" id="italic">
    <img src="<%= room.baseURL %>/icons/22_underline.svg" alt="underline" class="tool" id="underline">
    <img src="<%= room.baseURL %>/icons/21_strikethrough.svg" alt="strikethrough" class="tool" id="strikethrough">
    <img src="<%= room.baseURL %>/icons/20_heading.svg" alt="heading" class="tool coming-soon" id="heading">
    <img src="<%= room.baseURL %>/icons/19_writingdirection_leftright.svg" alt="writingdirection" class="tool coming-soon" id="writingdirection">
    <img src="<%= room.baseURL %>/icons/18_justification_left.svg" alt="justification" class="tool coming-soon" id="justification">
    <img src="<%= room.baseURL %>/icons/17_bulletnumbers.svg" alt="bullet numbers" class="tool coming-soon" id="bulletnumbers">
    <img src="<%= room.baseURL %>/icons/16_bulletpoints.svg" alt="bullet points" class="tool coming-soon" id="bulletpoints">
    <img src="<%= room.baseURL %>/icons/15_citation.svg" alt="quote" class="tool" id="citation">
    <img src="<%= room.baseURL %>/icons/14_font.svg" alt="font" class="tool coming-soon" id="font">
  </div>
  <div id="edit-toolbar">
    <img src="<%= room.baseURL %>/icons/13_audio.svg" alt="audio" class="tool coming-soon" id="audio">
    <img src="<%= room.baseURL %>/icons/12_video.svg" alt="video" class="tool coming-soon" id="video">
    <img src="<%= room.baseURL %>/icons/11_image.svg" alt="image" class="tool" id="image-upload">
    <img src="<%= room.baseURL %>/icons/10_links.svg" alt="link" class="tool coming-soon" id="links">
  </div>


  <script src="<%= room.baseURL %>/js/editButtons.js" defer type="module"></script>

  <div id="tooltip" class="drop-shadow"></div>

  <% } %>
  <div id="bounding"></div>
  <div id="notes"></div>

  <div id="note-buttons">
    <img src="<%= room.baseURL %>/icons/close.svg" class="btn" alt="close button" id="close-note">
    <img src="<%= room.baseURL %>/icons/06_undo.svg" class="btn" alt="restore button" id="restore-note">
    <% if(room.canEdit) { %>
    <img src="<%= room.baseURL %>/icons/02_pencil.svg" class="btn" alt="edit note" id="edit-note">
    <img src="<%= room.baseURL %>/icons/05_trash.svg" class="btn" alt="remove note" id="remove-note">
    <% } %>
  </div>
  <script src="<%= room.baseURL %>/js/room.js" defer type="module"></script>
</body>

</html>