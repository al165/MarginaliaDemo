<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= room.name %>
  </title>

  <% if(room.renderStatic) { %>
  <%- favicon %>
  <% } else { %>
  <link rel="icon" type="ico" href="<%= room.baseURL %>/favicon.ico">
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.core.css" rel="stylesheet" />
  <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
  <% } %>

  <script>
    const roomId = '<%= room.roomId %>';
    const roomName = '<%= room.name %>'
    const rootNote = '<%= room.rootNote %>';
    const theme = '<%= room.theme || "light" %>';
    const createdOn = '<%= room.createdOn %>';
    const params = new URLSearchParams(window.location.search);
    const editToken = params.get("editToken");
    const canEdit = '<%= room.canEdit %>' === 'true';
    const baseURL = '<%= room.baseURL %>';
    let editMode = false;

    console.log("theme: " + theme);
  </script>
  <% if(room.renderStatic) { %>
  <!-- Statically rendered data 
    - you may edit the data of the notes here, or add custom CSS properties, or any modifications you like!
  -->
  <script>
    window.notes = <%- JSON.stringify(notes, null, 2) %>;
  </script>
  <style>
    <%- css %>
  </style>
  <% } else {%>
  <link rel="stylesheet" href="<%= room.baseURL %>/style.css">
  <% } %>
</head>

<body>
  <div class="logo" id="logo1"></div>
  <div class="logo" id="logo2"></div>
  <% if(room.renderStatic) { %>
  <!-- Feel free to use your own logo here, or remove it entirely -->
  <img src="<%= icons.logo1 %>" alt="logo" class="logo-text">
  <img src="<%= icons.logo2 %>" alt="logo" class="logo-text">
  <% } else { %>
  <a href="<%= room.baseURL %>/"><img src="<%= room.baseURL %>/logo1.svg" alt="logo" class="logo-text"></a>
  <a href="<%= room.baseURL %>/"><img src="<%= room.baseURL %>/logo2.svg" alt="logo" class="logo-text"></a>
  <% } %>

  <% if(room.canEdit) { %>
  <%- include('partials/toolbar.ejs', {room}) %>
  <% } %>

  <div id="bounding"></div>
  <div id="notes"></div>

  <div id="note-buttons">

    <% if(room.renderStatic) { %>
    <img src="<%= icons.close %>" class="btn" alt="close button" id="close-note">
    <img src="<%= icons.undo %>" class="btn" alt="restore button" id="restore-note">
    <% } else { %>
    <img src="<%= room.baseURL %>/icons/close.svg" class="btn" alt="close button" id="close-note">
    <img src="<%= room.baseURL %>/icons/06_undo.svg" class="btn" alt="restore button" id="restore-note">
    <% } %>

    <% if(room.canEdit) { %>
    <img src="<%= room.baseURL %>/icons/02_pencil.svg" class="btn" alt="edit note" id="edit-note">
    <img src="<%= room.baseURL %>/icons/05_trash.svg" class="btn" alt="remove note" id="remove-note">
    <img src="<%= room.baseURL %>/icons/26_resize.svg" class="handle" alt="resize note" id="resize-note">
    <% } // if(room.canEdit) %>

  </div>

  <% if(room.renderStatic) { %>
  <script type="module">
    <%- include('partials/generated/roomStatic.ejs') %>
  </script>
  <% } else { %>
  <script src="<%= room.baseURL %>/js/room.js" defer type="module"></script>
  <% } %>

  <% if(room.canEdit) { %>
  <script src="<%= room.baseURL %>/js/noteEdit.js" defer type="module"></script>
  <% } %>
</body>

</html>