<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>welcome to margi-nalia</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      padding: 0;
    }

    #create {
      position: absolute;
      background-color: #E8E8E8;
      top: 50vh;
      left: 50vw;
      transform: translate(-50%, -50%);
      border: solid black 1px;
      box-shadow: #C2C1FF 0px 0px 48px 24px;
      padding: 2em;
      max-width: 30em;
    }
  </style>
</head>

<body>
  <div id="create">
    <p>Create a room for your notes.</p>
    <input type="text" name="roomname" id="room-name" placeholder="Room name...">
    <p>Make sure you bookmark/save the URL generated in the next page so that you can find it again!</p>
    <button disabled id="create-room-btn">
      Create Room
    </button>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const roomNameField = document.querySelector("#room-name");
      const createRoomBtn = document.querySelector("#create-room-btn");

      roomNameField.addEventListener('input', function(ev) {
        if (roomNameField.value)
          createRoomBtn.disabled = false;
        else
          createRoomBtn.disabled = true;
      });

      roomNameField.addEventListener('keydown', function(ev) {
        if (event.key == 'Enter') {
          createRoom();
        }
      })

      function createRoom() {
        fetch("<%= baseURL %>/room", {
          method: 'POST',
          body: JSON.stringify({
            roomName: roomNameField.value
          }),
          headers: {
            "Content-type": "application/json"
          }
        }).then((res) => res.json()).then((json) => {
          console.log(json);
          console.log(window.location);
          window.location.replace("<%= baseURL %>/room/" + json.roomId + "?editToken=" + json.editToken);
        });
      }

      createRoomBtn.addEventListener('click', createRoom);
    });
  </script>
</body>

</html>