<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>welcome to margi-nalia</title>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
    }
  </style>
</head>

<body>
  <div>
    <h1>Welcome to Marginalia</h1>

    <form action="<%= baseURL %>/newroom"><input type="text" name="roomname" style="margin: 0.5em 0.5em 0.5em 0em" placeholder="Name of your room">
      <input type="submit" value="Create a room">
    </form>

    <h3>Current rooms:</h3>
    <ul id="rooms">
      <% for(const room of rooms) { %>
      <li>
        <a href="<%= baseURL %>/room/<%= room.roomId %>"><%= room.name %></a> [<a href="<%= baseURL %>/room/<%= room.roomId %>?editToken=<%= room.editToken %>">edit</a>]
      </li>
      <% } %>
    </ul>
  </div>
</body>

</html>